# Configuration de l'application Parking Partagé

# Nom de l'application
APP_NAME="Parking Partage"

# MODE DE STOCKAGE - CLEAN ARCHITECTURE TEST
# 'sql' = Utilise MySQL/PDO (production)
# 'file' = Utilise fichiers JSON (développement/tests)
# Changez cette valeur pour tester que l'architecture fonctionne indépendamment de la couche de persistance
STORAGE_MODE=sql

# Configuration Base de Données MySQL (utilisée si STORAGE_MODE=sql)
DB_HOST=mysql
DB_NAME=parking_partage
DB_USER=parking_user
DB_PASSWORD=parking_password

# Configuration JWT (authentification)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters
JWT_EXPIRATION=3600

# Configuration Docker
# Port de l'application (http://localhost:8000)
APP_PORT=8000

# Port MySQL
MYSQL_PORT=3306

# Port PHPMyAdmin (http://localhost:8080)
PHPMYADMIN_PORT=8080
